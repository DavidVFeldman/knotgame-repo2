/-- The recorded distance of an orbit index from `1/2`. -/
def odep (i : ℕ) : ℕ := (orbCert.getD i (0, 0, 0)).1

/-- The recorded move producing an orbit index. -/
def omv (i : ℕ) : ℕ := (orbCert.getD i (0, 0, 0)).2.1

/-- The recorded predecessor of an orbit index. -/
def opar (i : ℕ) : ℕ := (orbCert.getD i (0, 0, 0)).2.2

/-- The check: `1/2` is at distance `0`, and every other index is the image of
its recorded predecessor, which is one step closer. -/
def orbChk : Bool :=
  (List.range 153).all (fun i =>
    if i = halfIdx then decide (odep i = 0)
    else decide (opar i < 153) && decide (odep (opar i) + 1 = odep i) &&
      decide (tget (tabOf (moveOf (omv i))) (opar i) = i))

theorem chk_orb : orbChk = true := by decide +kernel

lemma orbChk_at {i : ℕ} (hi : i < 153) :
    (if i = halfIdx then decide (odep i = 0)
      else decide (opar i < 153) && decide (odep (opar i) + 1 = odep i) &&
        decide (tget (tabOf (moveOf (omv i))) (opar i) = i)) = true :=
  List.all_eq_true.1 chk_orb i (List.mem_range.2 hi)

/-- Every listed orbit point is attained by a run of the game. -/
lemma mem_Orb_oget : ∀ (n i : ℕ), i < 153 → odep i ≤ n → tval (oget i) ∈ Orb rho := by
  intro n
  induction n with
  | zero =>
      intro i hi hd
      have hchk := orbChk_at hi
      by_cases hhalf : i = halfIdx
      · subst hhalf
        exact ⟨[], trivial, by rw [posAfter_nil, tval_oget_halfIdx]⟩
      · rw [if_neg hhalf] at hchk
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hchk
        omega
  | succ n ih =>
      intro i hi hd
      by_cases hhalf : i = halfIdx
      · subst hhalf
        exact ⟨[], trivial, by rw [posAfter_nil, tval_oget_halfIdx]⟩
      · have hchk := orbChk_at hi
        rw [if_neg hhalf] at hchk
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hchk
        obtain ⟨⟨hpar, hdep⟩, htget⟩ := hchk
        obtain ⟨w, hw, hpos⟩ := ih (opar i) hpar (by omega)
        have h255 : tget (tabOf (moveOf (omv i))) (opar i) ≠ 255 := by
          rw [htget]; omega
        have hsurv : survives rho (moveOf (omv i)) (tval (oget (opar i))) := by
          by_contra hc
          exact h255 ((tget_eq_255_iff hpar).2 hc)
        refine ⟨w ++ [moveOf (omv i)], ?_, ?_⟩
        · rw [survivesWord_append, hpos]
          exact ⟨hw, hsurv, trivial⟩
        · rw [posAfter_append, hpos]
          simp only [posAfter_cons, posAfter_nil]
          rw [← oget_tget hpar h255, htget]

lemma posAfter_mem_OrbSet : ∀ (w : List Move) (x : ℝ), x ∈ OrbSet →
    survivesWord rho x w → posAfter rho x w ∈ OrbSet
  | [], x, hx, _ => hx
  | m :: w, x, hx, hs => by
      rw [survivesWord_cons] at hs
      exact posAfter_mem_OrbSet w _ (OrbSet_closed x hx m hs.1) hs.2

/-- **The orbit is exactly the listed set.** -/
theorem Orb_rho_eq_OrbSet : Orb rho = OrbSet := by
  apply Set.eq_of_subset_of_subset
  · rintro x ⟨w, hw, rfl⟩
    exact posAfter_mem_OrbSet w _ half_mem_OrbSet hw
  · rintro x ⟨t, ht, rfl⟩
    obtain ⟨i, hi, hti⟩ := List.mem_iff_getElem.1 ht
    have hlen : orbitList.length = 153 := orbitList_length
    have hi' : i < 153 := by omega
    have hoget : oget i = t := by
      rw [oget, List.getD_eq_getElem _ _ hi, hti]
    rw [← hoget]
    exact mem_Orb_oget (odep i) i hi' le_rfl

lemma tval_inj_on_orbitList {t s : Tri} (ht : t ∈ orbitList) (hs : s ∈ orbitList)
    (h : tval t = tval s) : t = s := by
  by_contra hne
  have hd := orbitList_pairwise.forall (fun a b hab => by rwa [abs_sub_comm]) ht hs hne
  rw [h, sub_self, abs_zero] at hd
  linarith [deltaRho_pos]

/-- **Proposition 9, first clause.**  The orbit of `1/2` at the plastic number
has exactly `153` points. -/
theorem card_Orb_rho : (Orb rho).ncard = 153 := by
  classical
  have hnd : (orbitList.map tval).Nodup := by
    refine List.Nodup.map_on ?_ ?_
    · intro a ha b hb hab
      exact tval_inj_on_orbitList ha hb hab
    · refine orbitList_pairwise.imp ?_
      intro a b hab hne
      rw [hne, sub_self, abs_zero] at hab
      linarith [deltaRho_pos]
  have hset : Orb rho = ((orbitList.map tval).toFinset : Set ℝ) := by
    rw [Orb_rho_eq_OrbSet]
    ext x
    simp only [OrbSet, Set.mem_setOf_eq, Finset.mem_coe, List.mem_toFinset, List.mem_map]
  rw [hset, Set.ncard_coe_finset, List.toFinset_card_of_nodup hnd, List.length_map,
    orbitList_length]

