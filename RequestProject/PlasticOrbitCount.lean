  (7,0,58), (12,1,22), (6,1,23), (8,0,60), (9,1,24), (12,0,61), (21,1,25), (4,1,26), (17,0,63),
  (9,0,64), (8,1,27), (13,1,28), (7,1,29), (9,1,30), (3,0,69), (13,1,32), (18,0,70), (22,1,33),
  (5,1,34), (18,1,35), (6,0,72), (10,1,36), (9,1,37), (7,0,74), (11,0,75), (1,0,76), (10,1,40),
  (4,1,41), (7,0,78), (19,1,43), (9,0,79), (6,1,45), (5,0,81), (7,1,47), (11,1,48), (3,0,83),
  (16,0,84), (8,1,50), (14,0,85), (12,1,51), (13,0,86), (15,0,87), (2,1,52), (17,0,89),
  (4,0,90), (5,1,54), (8,1,55), (6,0,93), (10,1,57), (0,0,0), (10,0,95), (6,2,59), (8,2,60),
  (5,0,98), (4,2,62), (17,2,63), (2,0,100), (15,2,65), (13,2,66), (12,0,101), (14,2,67),
